# Files git should never track: installed packages, build output, test reports,
# secrets, and anything that could contain someone's real photos or catalog.

node_modules/
dist/
out/
release/
coverage/
playwright-report/
test-results/
*.log
.env
.env.*
!.env.example
.DS_Store

# Never commit real photo libraries or local catalogs
fixtures/private/
*.sqlite
*.sqlite-wal
*.sqlite-shm
