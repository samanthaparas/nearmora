// TypeScript settings for code that runs in Node: the main process, preload, shared code and unit tests.
// It has Node types but no browser types, so main-process code can't accidentally rely on `window`.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  // Component tests render React in a simulated browser, so they're type-checked with the UI's settings instead.
  "exclude": ["tests/component/**/*"]
}
