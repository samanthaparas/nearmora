{
  "name": "nearmora",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first photo favorites and memory studio",
  "author": "Samantha Paras",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/notices.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "query-plans": "node scripts/query-plans.mjs",
    "measure:scan": "npm run build && NEARMORA_MEASURE=1 playwright test e2e/measure-scan.spec.ts --reporter=list",
    "measure:perf": "npm run build && NEARMORA_PERF=1 playwright test e2e/measure-perf.spec.ts --reporter=list",
    "measure:studio": "npm run build && NEARMORA_STUDIO_PERF=1 playwright test e2e/measure-studio.spec.ts --reporter=list"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "exifr": "7.1.3",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/caveat": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tanstack/react-virtual": "3.14.19",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "opentype.js": "1.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "fsevents": false,
    "better-sqlite3": false
  }
}
